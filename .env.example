# Copy to `.env` at repo root for local development.
# On Render, set these in each service’s Environment tab (see DEPLOY.md).

# --- Web (Vite build-time; prefix VITE_) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
# New publishable key (Dashboard → API Keys)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy anon JWT — use this if browser login hits CORS on Authorization (optional override)
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Leave empty in dev to use Vite proxy (localhost:5173 → :3000)
VITE_API_URL=http://localhost:3000

# --- Server (runtime) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-secret-key

# Comma-separated browser origins allowed for Socket.IO CORS (production)
# CLIENT_ORIGIN=https://rune-race-web.onrender.com
CLIENT_ORIGIN=

NODE_ENV=development
PORT=3000
