# Copy to `.env` at repo root for local development.
# On Render, set these in each service’s Environment tab (see DEPLOY.md).

# --- Web (Vite build-time; prefix VITE_) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
# New publishable key (Dashboard → API Keys)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy anon JWT — use this if browser login hits CORS on Authorization (optional override)
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Leave empty in dev to use Vite proxy (web :5173, admin :5174 → server :3000)
VITE_API_URL=

# Canonical / Open Graph base URL (production: https://rune-race.onrender.com)
VITE_SITE_URL=https://rune-race.onrender.com

# --- Admin console (apps/admin, port 5174) — same Supabase vars as web ---
# Server allowlist (comma-separated Supabase user UUIDs)
# ADMIN_USER_IDS=your-admin-user-uuid

# Popup khuyến khích đăng ký cho user anon (server). false = tắt cứng, bỏ qua admin toggle.
# ACCOUNT_NUDGE_ENABLED=false

# Client-only override (build-time). false = không bao giờ hiện popup dù server bật.
# VITE_ACCOUNT_NUDGE_ENABLED=false

# --- Server (runtime) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-secret-key

# Postgres — scripts only. Paste full Supabase URI; special chars in password are OK.
# DATABASE_URL=postgresql://postgres.ref:password@aws-0-....pooler.supabase.com:6543/postgres

# Browser origins for Socket.IO + API CORS (comma-separated each).
# Production (Render): set automatically via render.yaml fromService.
# Local: leave empty (allows all origins) or set explicit URLs.
CLIENT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

NODE_ENV=development
PORT=3000
