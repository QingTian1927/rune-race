# Copy to `.env` at repo root for local development.
# On Render, set these in each service’s Environment tab (see DEPLOY.md).

# --- Web (Vite build-time; prefix VITE_) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
# New publishable key (Dashboard → API Keys)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy anon JWT — use this if browser login hits CORS on Authorization (optional override)
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Leave empty in dev to use Vite proxy (web :5173, admin :5174 → server :3000)
VITE_API_URL=

# --- Admin console (apps/admin, port 5174) — same Supabase vars as web ---
# Server allowlist (comma-separated Supabase user UUIDs)
# ADMIN_USER_IDS=your-admin-user-uuid

# --- Server (runtime) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-secret-key

# Comma-separated browser origins for Socket.IO + API CORS (production).
# Include both game web and admin console, e.g.:
# CLIENT_ORIGIN=https://rune-race-web.onrender.com,https://admin.example.com
# Local admin (5174) uses Vite proxy and does not need to be listed.
CLIENT_ORIGIN=

NODE_ENV=development
PORT=3000
