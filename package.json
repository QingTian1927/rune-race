{
  "name": "rune-race",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "pnpm install",
    "dev:web": "pnpm --filter @rune-race/web dev",
    "dev:admin": "pnpm --filter @rune-race/admin dev",
    "dev:server": "pnpm --filter @rune-race/server dev",
    "dev": "node scripts/dev.mjs",
    "dev:host": "node scripts/dev.mjs --host",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @rune-race/web build",
    "build:admin": "pnpm build:shared && pnpm --filter @rune-race/admin build",
    "build:server": "pnpm build:shared && pnpm build:game-engine && pnpm build:bot-ai && pnpm --filter @rune-race/server build",
    "build:render": "pnpm build:shared && pnpm build:game-engine && pnpm build:bot-ai && pnpm build:server && pnpm build:web",
    "build:shared": "pnpm --filter @rune-race/shared build",
    "build:game-engine": "pnpm --filter @rune-race/game-engine build",
    "build:bot-ai": "pnpm --filter @rune-race/bot-ai build",
    "test:bot-ai": "pnpm --filter @rune-race/bot-ai test",
    "test:game-engine": "pnpm --filter @rune-race/game-engine test",
    "test:server": "pnpm --filter @rune-race/server test",
    "type-check": "pnpm --filter @rune-race/web type-check && pnpm --filter @rune-race/admin type-check",
    "import:users": "node --env-file=.env scripts/import-users/index.mjs",
    "backfill:registration-dates": "node --env-file=.env scripts/backfill-registration-dates/index.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "pg": "^8.16.3",
    "xlsx": "^0.18.5"
  }
}
